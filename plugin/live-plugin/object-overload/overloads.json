  ],
  "wrappers": [
	"java.util.Optional",
	"net.minecraft.resources.ResourceKey",
	"net.minecraft.core.Holder",
	"net.minecraft.core.Holder.Reference",
	"net.minecraft.tags.TagKey",
	"dev.uncandango.kubegroovy.util.registrypredicate.RegistryPredicate"
  ],
  "enumsToObject": true,
  "typeRules": [
    {
      "type": "java.util.Map",
      "action": "keep",
      "args": [0, 1]
    },
    {
      "type": "java.util.List",
      "action": "keep",
      "args": [0]
    },
    {
      "type": "net.minecraft.core.HolderSet",
      "action": "replace",
      "replaceWith": "java.util.List",
      "args": [0],
      "requireEligibleArg": 0
    }
  ],
  "rewrite": {
    "scalar": "java.lang.Object",
    "array": "java.lang.Object[]",
    "collection": "java.util.List<java.lang.Object>"
  }
}
