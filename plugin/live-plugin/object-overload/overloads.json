    "net.minecraft.nbt.Tag",
    "net.minecraft.network.chat.ClickEvent",
    "net.minecraft.network.chat.Component",
    "net.minecraft.network.chat.MutableComponent",
    "net.minecraft.network.chat.TextColor",
